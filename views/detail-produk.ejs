<%- include('partials/header', { title: product ? product.name : 'Detail Produk' }) %>

<header class="main-header">
    <%- include('partials/topbar') %>
    <%- include('partials/navbar') %>
</header>

<main class="detail-page py-4">
    <div class="container">
        <% if (!product) { %>
            <div class="empty-products detail-empty text-center p-5 bg-white rounded-3 shadow-sm my-4">
                <i class="bi bi-box display-4 text-muted"></i>
                <h2 class="mt-3">Produk Tidak Ditemukan</h2>
                <p class="text-muted">Produk yang Anda cari tidak tersedia atau telah dihapus.</p>
                <a href="<%= page_url('produk') %>" class="btn btn-primary mt-2">Kembali ke Katalog</a>
            </div>
        <% } else { %>
            <!-- Breadcrumbs -->
            <div class="catalog-breadcrumb mb-4">
                <a href="<%= page_url('') %>">Home</a>
                <i class="bi bi-chevron-right"></i>
                <a href="<%= page_url('produk') %>">Produk</a>
                <i class="bi bi-chevron-right"></i>
                <a href="<%= page_url('produk?kategori=' + encodeURIComponent(product.category)) %>"><%= product.category %></a>
                <i class="bi bi-chevron-right"></i>
                <span><%= product.name %></span>
            </div>

            <!-- Product Card -->
            <section class="product-detail-card bg-white p-4 p-md-5 rounded-4 shadow-sm">
                <div class="row g-4 g-lg-5">
                    <!-- Left: Gallery -->
                    <div class="col-lg-5">
                        <div class="detail-gallery">
                            <div class="detail-main-image text-center p-3 rounded-3 border bg-light">
                                <img src="<%= product_image_url(product.image) %>" alt="<%= product.name %>" class="img-fluid rounded" style="max-height: 420px; object-fit: contain;">
                            </div>
                            <div class="detail-mini-note mt-3 p-3 bg-light rounded-3 d-flex align-items-center gap-2 text-muted small">
                                <i class="bi bi-shield-check text-success fs-5"></i>
                                <span>Hasil cetak tajam, warna akurat & finishing terstandar.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Details & Order -->
                    <div class="col-lg-7">
                        <div class="detail-content">
                            <span class="badge bg-secondary mb-2 px-3 py-2 fs-6"><%= product.category %></span>
                            <h1 class="h2 fw-bold text-dark mb-2"><%= product.name %></h1>
                            <div class="detail-rating d-flex align-items-center gap-2 mb-3 text-muted small">
                                <span class="text-warning"><i class="bi bi-star-fill"></i> 5.0</span>
                                <span>•</span>
                                <span>Pesanan Satuan / Partai Besar</span>
                            </div>

                            <!-- Pricing Section -->
                            <div class="p-3 bg-light rounded-3 mb-4">
                                <small class="text-muted d-block">Harga per <%= product.unit %>:</small>
                                <div class="d-flex align-items-baseline gap-2">
                                    <h2 class="text-danger fw-bold mb-0" id="currentUnitPrice"><%= format_rupiah(product.price) %></h2>
                                    <span class="text-muted">/ <%= product.unit %></span>
                                </div>
                                <% if (product.pricing && product.pricing.length > 0) { %>
                                    <div class="mt-3">
                                        <small class="fw-bold text-secondary d-block mb-1">Daftar Harga Grosir (Bertingkat):</small>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered bg-white mb-0 small">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Jumlah Pembelian</th>
                                                        <th>Harga Satuan</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% product.pricing.forEach(function(tier) { %>
                                                        <tr>
                                                            <td>
                                                                <%= tier.min_qty %> <%= product.unit %>
                                                                <%= tier.max_qty ? '- ' + tier.max_qty + ' ' + product.unit : 'ke atas' %>
                                                            </td>
                                                            <td class="fw-semibold text-danger"><%= format_rupiah(tier.price) %></td>
                                                        </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Description -->
                            <div class="mb-4">
                                <h5 class="fw-bold">Deskripsi Produk</h5>
                                <p class="text-muted"><%= product.description %></p>
                            </div>

                            <!-- Features List -->
                            <% if (product.features && product.features.length > 0) { %>
                                <div class="mb-4">
                                    <h5 class="fw-bold">Keunggulan & Spesifikasi:</h5>
                                    <ul class="list-unstyled row g-2">
                                        <% product.features.forEach(function(feat) { %>
                                            <li class="col-sm-6 text-muted"><i class="bi bi-check-circle-fill text-success me-2"></i> <%= feat %></li>
                                        <% }); %>
                                    </ul>
                                </div>
                            <% } %>

                            <hr>

                            <!-- Add to Cart / Order Form -->
                            <form action="<%= page_url('cart') %>" method="POST" id="orderForm">
                                <input type="hidden" name="action" value="add">
                                <input type="hidden" name="product_id" value="<%= product.id %>">

                                <div class="row align-items-center mb-4">
                                    <div class="col-sm-4 mb-2 mb-sm-0">
                                        <label for="quantityInput" class="form-label fw-bold">Jumlah (<%= product.unit %>):</label>
                                        <div class="input-group">
                                            <button class="btn btn-outline-secondary" type="button" id="qtyMinus">-</button>
                                            <input type="number" id="quantityInput" name="quantity" class="form-control text-center" value="1" min="1" max="100000">
                                            <button class="btn btn-outline-secondary" type="button" id="qtyPlus">+</button>
                                        </div>
                                    </div>
                                    <div class="col-sm-8 text-sm-end">
                                        <small class="text-muted d-block">Total Estimasi:</small>
                                        <h3 class="fw-bold text-danger mb-0" id="totalEstimateDisplay"><%= format_rupiah(product.price) %></h3>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                        <i class="bi bi-cart-plus me-1"></i> Masukkan ke Keranjang
                                    </button>
                                    <a id="waOrderBtn" href="https://wa.me/<%= whatsapp_number %>?text=Halo%20Rosa%20Indah%20Printing,%20saya%20tertarik%20dengan%20produk%20<%= encodeURIComponent(product.name) %>" 
                                       target="_blank" rel="noopener" class="btn btn-success btn-lg flex-grow-1">
                                        <i class="bi bi-whatsapp me-1"></i> Chat WhatsApp
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>
    </div>
</main>

<script>
    const pricingTiers = <%- JSON.stringify(product && product.pricing ? product.pricing : []) %>;
    const basePrice = <%= product ? product.price : 0 %>;
    const unitName = "<%= product ? product.unit : 'pcs' %>";
    const prodName = "<%= product ? product.name : '' %>";
    const waNumber = "<%= whatsapp_number %>";

    function computeUnitPrice(qty) {
        if (!pricingTiers || pricingTiers.length === 0) return basePrice;
        for (const tier of pricingTiers) {
            const min = tier.min_qty || 1;
            const max = tier.max_qty;
            if (qty >= min && (max === null || max === undefined || qty <= max)) {
                return tier.price;
            }
        }
        return basePrice;
    }

    function formatRupiah(num) {
        return 'Rp' + Number(num || 0).toLocaleString('id-ID');
    }

    const qtyInput = document.getElementById('quantityInput');
    const minusBtn = document.getElementById('qtyMinus');
    const plusBtn = document.getElementById('qtyPlus');
    const unitPriceDisplay = document.getElementById('currentUnitPrice');
    const totalDisplay = document.getElementById('totalEstimateDisplay');
    const waBtn = document.getElementById('waOrderBtn');

    function updateCalculations() {
        if (!qtyInput) return;
        let qty = parseInt(qtyInput.value, 10);
        if (isNaN(qty) || qty < 1) qty = 1;
        qtyInput.value = qty;

        const unitPrice = computeUnitPrice(qty);
        const subtotal = unitPrice * qty;

        if (unitPriceDisplay) unitPriceDisplay.innerText = formatRupiah(unitPrice);
        if (totalDisplay) totalDisplay.innerText = formatRupiah(subtotal);

        if (waBtn) {
            const msg = `Halo Rosa Indah Printing, saya ingin pesan:
- Produk: ${prodName}
- Jumlah: ${qty} ${unitName}
- Estimasi: ${formatRupiah(subtotal)}`;
            waBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
        }
    }

    if (qtyInput) {
        qtyInput.addEventListener('input', updateCalculations);
        if (minusBtn) minusBtn.addEventListener('click', () => {
            let v = parseInt(qtyInput.value, 10) || 1;
            if (v > 1) { qtyInput.value = v - 1; updateCalculations(); }
        });
        if (plusBtn) plusBtn.addEventListener('click', () => {
            let v = parseInt(qtyInput.value, 10) || 1;
            qtyInput.value = v + 1; updateCalculations();
        });
        updateCalculations();
    }
</script>

<%- include('partials/footer') %>
