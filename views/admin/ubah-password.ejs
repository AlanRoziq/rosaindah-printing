<%- include('_header', { title: 'Ubah Password' }) %>

<div class="admin-title">
    <div>
        <h1>Keamanan & Ubah Password</h1>
        <p>Perbarui password akun administrator percetakan secara berkala untuk menjaga keamanan sistem.</p>
    </div>
</div>

<% if (notice) { %>
    <div class="admin-alert">
        <i class="bi bi-check-circle-fill"></i>
        <span><%= notice %></span>
    </div>
<% } %>

<% if (error) { %>
    <div class="admin-alert error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= error %></span>
    </div>
<% } %>

<div style="max-width: 580px;">
    <div class="admin-card">
        <div style="margin-bottom: 20px;">
            <h2 style="margin: 0; color: #18243a; font-size: 18px; font-weight: 800;">
                <i class="bi bi-shield-lock" style="color: #e11d64;"></i> Form Perubahan Password
            </h2>
            <p style="margin: 4px 0 0; color: #7d747c; font-size: 13px;">
                Pastikan password baru minimal 5 karakter dan kombinasi yang kuat.
            </p>
        </div>

        <form action="<%= page_url('admin/ubah-password') %>" method="POST" class="admin-form">
            <div class="admin-field">
                <label>Password Saat Ini *</label>
                <input type="password" name="current_password" required placeholder="Masukkan password admin saat ini">
            </div>

            <div class="admin-field">
                <label>Password Baru *</label>
                <input type="password" name="new_password" required minlength="5" placeholder="Masukkan password baru">
            </div>

            <div class="admin-field">
                <label>Konfirmasi Password Baru *</label>
                <input type="password" name="confirm_password" required minlength="5" placeholder="Ulangi password baru">
            </div>

            <div style="margin-top: 10px;">
                <button type="submit" class="admin-btn" style="width: 100%; justify-content: center; padding: 11px;">
                    <i class="bi bi-key-fill"></i> Simpan Password Baru
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('_footer') %>
