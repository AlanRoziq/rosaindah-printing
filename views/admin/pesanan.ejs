<%- include('_header', { title: 'Kelola Pesanan' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Daftar & Alur Pesanan Cetak</h2>
        <p class="text-muted mb-0">Kelola status produksi, verifikasi pembayaran, dan detail spesifikasi pemesan.</p>
    </div>
</div>

<% if (notice) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<!-- Filter tabs -->
<div class="card p-3 rounded-4 shadow-sm border-0 bg-white mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="fw-bold small text-muted me-2">Filter Status:</span>
        <a href="<%= page_url('admin/pesanan') %>" class="btn btn-sm <%= !statusFilter && !paymentFilter ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill">Semua</a>
        <a href="<%= page_url('admin/pesanan?status=pending') %>" class="btn btn-sm <%= statusFilter === 'pending' ? 'btn-warning text-dark' : 'btn-outline-secondary' %> rounded-pill">Baru Masuk</a>
        <a href="<%= page_url('admin/pesanan?status=confirmed') %>" class="btn btn-sm <%= statusFilter === 'confirmed' ? 'btn-info text-dark' : 'btn-outline-secondary' %> rounded-pill">Dikonfirmasi</a>
        <a href="<%= page_url('admin/pesanan?status=processing') %>" class="btn btn-sm <%= statusFilter === 'processing' ? 'btn-secondary' : 'btn-outline-secondary' %> rounded-pill">Diproses</a>
        <a href="<%= page_url('admin/pesanan?status=printed') %>" class="btn btn-sm <%= statusFilter === 'printed' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill">Dicetak</a>
        <a href="<%= page_url('admin/pesanan?status=completed') %>" class="btn btn-sm <%= statusFilter === 'completed' ? 'btn-success' : 'btn-outline-secondary' %> rounded-pill">Selesai</a>
        <a href="<%= page_url('admin/pesanan?payment=waiting') %>" class="btn btn-sm <%= paymentFilter === 'waiting' ? 'btn-danger' : 'btn-outline-danger' %> rounded-pill ms-auto">
            <i class="bi bi-exclamation-circle"></i> Perlu Verifikasi Bayar
        </a>
    </div>
</div>

<!-- Orders Table -->
<div class="card p-4 rounded-4 shadow-sm border-0 bg-white">
    <% if (orders.length === 0) { %>
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-3"></i>
            Tidak ada pesanan pada filter ini.
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nomor Pesanan</th>
                        <th>Pelanggan</th>
                        <th>Item Pesanan</th>
                        <th>Total</th>
                        <th>Status Order</th>
                        <th>Pembayaran</th>
                        <th style="min-width: 140px;">Ubah Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(function(o) { %>
                        <tr>
                            <td>
                                <strong class="d-block text-dark"><%= o.order_code %></strong>
                                <small class="text-muted"><%= o.created_at %></small>
                                <div class="mt-1">
                                    <a href="https://wa.me/<%= o.customer_phone.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="badge bg-success text-decoration-none">
                                        <i class="bi bi-whatsapp"></i> Chat WA
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold"><%= o.customer_name %></div>
                                <small class="text-muted d-block"><%= o.customer_phone %></small>
                                <% if (o.customer_address) { %>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 180px;"><%= o.customer_address %></small>
                                <% } %>
                            </td>
                            <td>
                                <% o.items.forEach(function(it) { %>
                                    <div class="small">
                                        <b><%= it.product_name %></b> (<%= it.quantity %> <%= it.unit %>)
                                    </div>
                                <% }); %>
                                <% if (o.customer_note) { %>
                                    <div class="small text-danger fst-italic mt-1">Catatan: <%= o.customer_note %></div>
                                <% } %>
                            </td>
                            <td>
                                <span class="fw-bold text-danger"><%= format_rupiah(o.total_estimate) %></span>
                            </td>
                            <td>
                                <span class="status-pill status-pill-<%= o.status %>">
                                    <%= o.status.toUpperCase() %>
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-<%= o.payment_status === 'paid' ? 'success' : (o.payment_status === 'waiting' ? 'warning text-dark' : 'danger') %>">
                                    <%= o.payment_status.toUpperCase() %>
                                </span>
                                <% if (o.payment_proof) { %>
                                    <div class="small text-success mt-1"><i class="bi bi-paperclip"></i> Bukti Ada</div>
                                <% } %>
                            </td>
                            <td>
                                <form action="<%= page_url('admin/pesanan/status') %>" method="POST" class="d-flex flex-column gap-1">
                                    <input type="hidden" name="order_code" value="<%= o.order_code %>">
                                    <select name="status" class="form-select form-select-sm">
                                        <option value="pending" <%= o.status === 'pending' ? 'selected' : '' %>>Baru (Pending)</option>
                                        <option value="confirmed" <%= o.status === 'confirmed' ? 'selected' : '' %>>Dikonfirmasi</option>
                                        <option value="processing" <%= o.status === 'processing' ? 'selected' : '' %>>Diproses Cetak</option>
                                        <option value="printed" <%= o.status === 'printed' ? 'selected' : '' %>>Dicetak Selesai</option>
                                        <option value="completed" <%= o.status === 'completed' ? 'selected' : '' %>>Selesai / Terkirim</option>
                                        <option value="cancelled" <%= o.status === 'cancelled' ? 'selected' : '' %>>Dibatalkan</option>
                                    </select>
                                    <select name="payment_status" class="form-select form-select-sm">
                                        <option value="waiting" <%= o.payment_status === 'waiting' ? 'selected' : '' %>>Menunggu Bayar</option>
                                        <option value="paid" <%= o.payment_status === 'paid' ? 'selected' : '' %>>Lunas</option>
                                        <option value="unpaid" <%= o.payment_status === 'unpaid' ? 'selected' : '' %>>Belum Bayar</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary py-0 mt-1">Simpan</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include('_footer') %>
