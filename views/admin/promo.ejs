<%- include('_header', { title: 'Promo & Voucher' }) %>

<div class="admin-title">
    <div>
        <h1>Promo & Voucher</h1>
        <p>Buat promo diskon otomatis dan kode kupon voucher khusus Member.</p>
    </div>
</div>

<% if (notice) { %>
    <div class="admin-alert">
        <i class="bi bi-check-circle-fill"></i>
        <span><%= notice %></span>
    </div>
<% } %>

<% if (error) { %>
    <div class="admin-alert error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= error %></span>
    </div>
<% } %>

<!-- Promo & Voucher Form -->
<div class="admin-card">
    <div style="margin-bottom: 18px;">
        <h2 style="margin: 0; color: #18243a; font-size: 18px; font-weight: 800;">
            <%= editData ? 'Edit Promo / Voucher' : 'Tambah Promo / Voucher Baru' %>
        </h2>
        <p style="margin: 4px 0 0; color: #7d747c; font-size: 13px;">
            Promo otomatis akan langsung memotong total belanja. Voucher menggunakan kode unik yang dimasukkan pemesan di checkout.
        </p>
    </div>

    <form action="<%= page_url('admin/promo') %>" method="POST" class="admin-form">
        <input type="hidden" name="action" value="save">
        <input type="hidden" name="id" value="<%= editId %>">

        <div class="admin-grid-2">
            <div class="admin-field">
                <label>Jenis Promosi *</label>
                <select name="kind" id="promoKind" onchange="toggleVoucherCode(this.value)">
                    <option value="promotion" <%= editKind !== 'voucher' ? 'selected' : '' %>>Promo Otomatis</option>
                    <option value="voucher" <%= editKind === 'voucher' ? 'selected' : '' %>>Voucher Kode</option>
                </select>
            </div>
            <div class="admin-field">
                <label>Nama Promo / Program *</label>
                <input type="text" name="name" required placeholder="Contoh: Diskon Kilat Ramadhan" value="<%= editData ? editData.name : '' %>">
            </div>
        </div>

        <div class="admin-grid-2" id="voucherCodeWrap" style="<%= editKind === 'voucher' ? '' : 'display: none;' %>">
            <div class="admin-field">
                <label>Kode Voucher (Kupon Unik) *</label>
                <input type="text" name="code" placeholder="Contoh: CETAKHEMAT10" value="<%= editData ? editData.code : '' %>" style="text-transform: uppercase;">
            </div>
            <div class="admin-field">
                <label>Batas Kuota Pemakaian</label>
                <input type="number" name="quota" min="1" placeholder="Kosongkan jika tanpa batas kuota" value="<%= editData ? editData.quota : '' %>">
            </div>
        </div>

        <div class="admin-grid-2">
            <div class="admin-field">
                <label>Jenis Potongan Diskon *</label>
                <select name="discount_type">
                    <option value="percent" <%= editData && editData.discount_type === 'percent' ? 'selected' : '' %>>Persentase (%)</option>
                    <option value="fixed" <%= editData && editData.discount_type === 'fixed' ? 'selected' : '' %>>Nominal Rupiah (Rp)</option>
                </select>
            </div>
            <div class="admin-field">
                <label>Besar Nilai Diskon *</label>
                <input type="number" name="discount_value" required min="1" placeholder="Contoh: 10 untuk 10% atau 15000 untuk Rp15.000" value="<%= editData ? editData.discount_value : '' %>">
            </div>
        </div>

        <div class="admin-grid-2">
            <div class="admin-field">
                <label>Minimal Nilai Belanja (Rp)</label>
                <input type="number" name="min_order" min="0" placeholder="0" value="<%= editData ? editData.min_order : 0 %>">
            </div>
            <div class="admin-field">
                <label>Maksimal Potongan Diskon (Opsional)</label>
                <input type="number" name="max_discount" min="0" placeholder="Kosongkan jika tidak dibatasi" value="<%= editData ? editData.max_discount : '' %>">
            </div>
        </div>

        <div class="admin-grid-2">
            <div class="admin-field">
                <label>Target Kategori</label>
                <select name="scope_type">
                    <option value="all">Semua Produk & Layanan</option>
                    <% categories.forEach(function(c) { %>
                        <option value="category:<%= c %>">Kategori: <%= c %></option>
                    <% }); %>
                </select>
            </div>
            <div class="admin-field">
                <label>Status Promosi</label>
                <select name="status">
                    <option value="active" <%= !editData || editData.status === 'active' ? 'selected' : '' %>>Aktif</option>
                    <option value="inactive" <%= editData && editData.status === 'inactive' ? 'selected' : '' %>>Nonaktif</option>
                </select>
            </div>
        </div>

        <div class="admin-field">
            <label>Deskripsi & Syarat Ketentuan</label>
            <textarea name="description" rows="2" placeholder="Tuliskan keterangan promo yang tampil kepada customer..."><%= editData ? editData.description : '' %></textarea>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; justify-content: flex-end;">
            <% if (editData) { %>
                <a href="<%= page_url('admin/promo') %>" class="admin-btn secondary">Batal</a>
            <% } %>
            <button type="submit" class="admin-btn">
                <i class="bi bi-save"></i> <%= editData ? 'Simpan Perubahan' : 'Simpan Promo Baru' %>
            </button>
        </div>
    </form>
</div>

<!-- Promo Otomatis List -->
<div class="admin-card" style="padding: 0; overflow: hidden; margin-bottom: 22px;">
    <div style="padding: 16px 22px; border-bottom: 1px solid #f2dce7; background: #fffcfd;">
        <h2 style="margin: 0; color: #18243a; font-size: 17px; font-weight: 800;">Daftar Promo Otomatis</h2>
    </div>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="admin-table" style="min-width: 820px;">
            <thead>
                <tr>
                    <th>Nama Promo</th>
                    <th>Diskon</th>
                    <th>Minimal Belanja</th>
                    <th>Terpakai</th>
                    <th>Status</th>
                    <th style="width: 130px; text-align: center;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (promos.length === 0) { %>
                    <tr>
                        <td colspan="6" style="text-align: center; color: #9c919a; padding: 30px;">Belum ada promo otomatis.</td>
                    </tr>
                <% } else { %>
                    <% promos.forEach(function(p) { %>
                        <tr>
                            <td>
                                <strong style="color: #18243a;"><%= p.name %></strong>
                                <small style="display: block; color: #887e87; font-size: 11.5px; margin-top: 2px;"><%= p.description %></small>
                            </td>
                            <td>
                                <strong style="color: #e11d64;">
                                    <%= p.discount_type === 'fixed' ? format_rupiah(p.discount_value) : p.discount_value + '%' %>
                                </strong>
                            </td>
                            <td style="font-variant-numeric: tabular-nums;"><%= format_rupiah(p.min_order) %></td>
                            <td><%= p.usage_count %> kali</td>
                            <td>
                                <span class="status-pill <%= p.status === 'active' ? 'status-pill-completed' : 'status-pill-cancelled' %>">
                                    <%= p.status %>
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 6px; justify-content: center;">
                                    <a href="<%= page_url('admin/promo?kind=promotion&id=' + p.id) %>" class="admin-btn secondary" style="padding: 5px 9px; font-size: 11.5px; border-radius: 8px;">Edit</a>
                                    <form action="<%= page_url('admin/promo') %>" method="POST" onsubmit="return confirm('Hapus promo ini?');" style="margin: 0;">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="kind" value="promotion">
                                        <input type="hidden" name="id" value="<%= p.id %>">
                                        <button type="submit" class="admin-btn danger" style="padding: 5px 9px; font-size: 11.5px; border-radius: 8px;">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Voucher Kode List -->
<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 16px 22px; border-bottom: 1px solid #f2dce7; background: #fffcfd;">
        <h2 style="margin: 0; color: #18243a; font-size: 17px; font-weight: 800;">Daftar Kode Voucher</h2>
    </div>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="admin-table" style="min-width: 820px;">
            <thead>
                <tr>
                    <th>Kode Kupon</th>
                    <th>Nama Voucher</th>
                    <th>Besar Diskon</th>
                    <th>Min. Belanja</th>
                    <th>Status</th>
                    <th style="width: 130px; text-align: center;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (vouchers.length === 0) { %>
                    <tr>
                        <td colspan="6" style="text-align: center; color: #9c919a; padding: 30px;">Belum ada voucher kode.</td>
                    </tr>
                <% } else { %>
                    <% vouchers.forEach(function(v) { %>
                        <tr>
                            <td>
                                <code style="background: #ffe8f1; color: #e11d64; padding: 4px 9px; border-radius: 7px; font-weight: 800; font-size: 12.5px; letter-spacing: 0.05em;"><%= v.code %></code>
                            </td>
                            <td>
                                <strong style="color: #18243a;"><%= v.name %></strong>
                                <small style="display: block; color: #887e87; font-size: 11.5px; margin-top: 2px;"><%= v.description %></small>
                            </td>
                            <td>
                                <strong style="color: #e11d64;">
                                    <%= v.discount_type === 'fixed' ? format_rupiah(v.discount_value) : v.discount_value + '%' %>
                                </strong>
                            </td>
                            <td style="font-variant-numeric: tabular-nums;"><%= format_rupiah(v.min_order) %></td>
                            <td>
                                <span class="status-pill <%= v.status === 'active' ? 'status-pill-completed' : 'status-pill-cancelled' %>">
                                    <%= v.status %>
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 6px; justify-content: center;">
                                    <a href="<%= page_url('admin/promo?kind=voucher&id=' + v.id) %>" class="admin-btn secondary" style="padding: 5px 9px; font-size: 11.5px; border-radius: 8px;">Edit</a>
                                    <form action="<%= page_url('admin/promo') %>" method="POST" onsubmit="return confirm('Hapus voucher ini?');" style="margin: 0;">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="kind" value="voucher">
                                        <input type="hidden" name="id" value="<%= v.id %>">
                                        <button type="submit" class="admin-btn danger" style="padding: 5px 9px; font-size: 11.5px; border-radius: 8px;">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
function toggleVoucherCode(val) {
    var wrap = document.getElementById('voucherCodeWrap');
    if (wrap) {
        wrap.style.display = (val === 'voucher') ? 'grid' : 'none';
    }
}
</script>

<%- include('_footer') %>
