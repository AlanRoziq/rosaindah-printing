<%- include('_header', { title: (typeof action !== 'undefined' && action === 'edit') ? 'Edit Produk' : ((typeof action !== 'undefined' && action === 'create') ? 'Tambah Produk' : 'Kelola Produk') }) %>

<% if (typeof notice !== 'undefined' && notice) { %>
    <div class="admin-alert">
        <i class="bi bi-check-circle-fill"></i>
        <span><%= notice %></span>
    </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="admin-alert" style="background:#fff2f2;border-color:#f5c6cb;color:#b02a37;">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= error %></span>
    </div>
<% } %>

<% if (typeof action !== 'undefined' && (action === 'create' || action === 'edit')) { %>
    <!-- ========================================== -->
    <!-- DEDICATED PRODUCT FORM (CREATE / EDIT)      -->
    <!-- Restores original upload workflow + SPECS  -->
    <!-- ========================================== -->
    <div class="admin-title">
        <div>
            <h1><%= action === 'edit' ? 'Edit Produk' : 'Tambah Produk' %></h1>
            <p style="color:#777">Kelola informasi produk yang tampil di katalog Rosa Indah Printing.</p>
        </div>
        <a class="admin-btn secondary" href="<%= page_url('admin/produk') %>">
            <i class="bi bi-arrow-left"></i> Kembali
        </a>
    </div>

    <div class="admin-card">
        <form class="admin-form" method="POST" action="<%= page_url('admin/produk') %>" enctype="multipart/form-data">
            <input type="hidden" name="mode" value="save">
            <input type="hidden" name="old_id" value="<%= product.id %>">
            <input type="hidden" name="current_image" value="<%= product.image %>">

            <div class="admin-grid-2">
                <div class="admin-field">
                    <label>Nama Produk *</label>
                    <input name="name" value="<%= product.name %>" required maxlength="180" placeholder="Contoh: Banner & Spanduk">
                </div>
                <div class="admin-field">
                    <label>ID Produk</label>
                    <input name="id" value="<%= product.id %>" placeholder="contoh: banner-spanduk" maxlength="80">
                    <small style="color:#8b8088">Huruf kecil, angka, dan tanda strip. Kosongkan saat tambah untuk dibuat otomatis.</small>
                </div>
            </div>

            <div class="admin-grid-2">
                <div class="admin-field">
                    <label>Kategori *</label>
                    <select name="category" required>
                        <option value="">Pilih kategori</option>
                        <% categories.forEach(function(c) { %>
                            <option value="<%= c %>" <%= product.category === c ? 'selected' : '' %>>
                                <%= c %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="admin-field">
                    <label>Harga Mulai</label>
                    <input type="number" min="0" step="1" name="price" value="<%= product.price %>" placeholder="Contoh: 25000">
                </div>
            </div>

            <div class="admin-field">
                <label>Harga Bertingkat <small style="font-weight:400">(opsional)</small></label>
                <textarea name="price_tiers" rows="4" placeholder="1-49=5000&#10;50-99=4000&#10;100+=3500"><%= formattedPriceTiers %></textarea>
                <small style="display:block;color:#8b8088;margin-top:7px">Contoh: 1-49=5000, 50-99=4000, 100+=3500. Harga otomatis mengikuti jumlah saat checkout.</small>
            </div>

            <div class="admin-grid-2">
                <div class="admin-field">
                    <label>Satuan</label>
                    <input name="unit" value="<%= product.unit || 'pcs' %>" placeholder="pcs / lembar / meter" maxlength="50">
                </div>
                <div class="admin-field">
                    <label>Status</label>
                    <select name="status">
                        <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Aktif</option>
                        <option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>>Nonaktif</option>
                    </select>
                </div>
            </div>

            <!-- DESKRIPSI PRODUK (2 INPUT: DESKRIPSI SINGKAT & DESKRIPSI LENGKAP) -->
            <div class="admin-field">
                <label>1. Deskripsi Singkat <small style="font-weight:400">(Tampil pada cuplikan katalog & ringkasan produk)</small></label>
                <textarea name="short_description" rows="2" placeholder="Contoh: Banner promosi outdoor bahan flexi tebal dengan hasil cetak tajam dan warna cerah."><%= product.short_description || product.description %></textarea>
                <small style="display:block;color:#8b8088;margin-top:5px">Ringkasan cepat (1-2 kalimat) untuk menarik perhatian calon pelanggan.</small>
            </div>

            <div class="admin-field">
                <label>2. Deskripsi Lengkap <small style="font-weight:400">(Tampil mendalam pada halaman detail produk)</small></label>
                <textarea name="full_description" rows="5" placeholder="Contoh: Cetak spanduk dan banner outdoor/indoor dengan teknologi digital printing resolusi tinggi. Menggunakan tinta solvent anti-luntur yang tahan panas matahari dan hujan lebat. Sangat cocok untuk promosi toko, event, wisuda, dan baliho..."><%= product.full_description || product.description %></textarea>
                <small style="display:block;color:#8b8088;margin-top:5px">Penjelasan lengkap mengenai kegunaan, kelebihan, daya tahan bahan, panduan desain, dan waktu produksi.</small>
            </div>

            <!-- SPESIFIKASI PRODUK (FITUR BARU SESUAI PERMINTAAN) -->
            <div class="admin-field">
                <label style="color:#e11d64;display:flex;align-items:center;gap:6px;">
                    <i class="bi bi-card-checklist"></i> Spesifikasi Produk <small style="font-weight:400;color:#555">(Bahan, Ukuran standar, Finishing, Minimal order, dll)</small>
                </label>
                <textarea name="specifications" rows="4" placeholder="Contoh:&#10;Bahan: Flexi Korea 440gr / Frontlite 280gr&#10;Ukuran: Standar / Custom sesuai kebutuhan&#10;Finishing: Mata ayam / Kolong bambu / Lipat pres&#10;Minimal Order: 1 pcs / meter&#10;Mesin: Cetak Digital Hi-Res"><%= product.specifications || '' %></textarea>
                <small style="display:block;color:#8b8088;margin-top:6px">Spesifikasi teknis produk untuk membantu pelanggan memahami detail bahan, gramatur, dan ukuran.</small>
            </div>

            <div class="admin-field">
                <label>Keunggulan Produk <small style="font-weight:400">(satu poin per baris)</small></label>
                <textarea name="features" rows="3" placeholder="Desain custom&#10;Cetak full color&#10;Bahan berkualitas&#10;Siap pasang"><%= (product.features || []).join('\n') %></textarea>
            </div>

            <div class="admin-grid-2">
                <div class="admin-field">
                    <label>Foto Produk <%= action === 'create' ? '*' : '' %></label>
                    <input type="file" name="image" accept="image/jpeg,image/png,image/webp">
                    <small style="display:block;color:#8b8088;margin-top:7px">JPG, PNG, WEBP — maksimal 5 MB.</small>
                    <% if (product.image) { %>
                        <div style="margin-top:12px;display:flex;align-items:center;gap:12px">
                            <img class="admin-product-img" style="width:90px;height:90px" src="<%= product_image_url(product.image) %>" alt="<%= product.name %>">
                            <span style="font-size:12px;color:#8b8088">Foto saat ini. Pilih file baru jika ingin menggantinya.</span>
                        </div>
                    <% } %>
                </div>

                <div class="admin-field">
                    <label>&nbsp;</label>
                    <label class="admin-check" style="display:flex;align-items:center;gap:8px;font-weight:700;cursor:pointer;margin-top:8px;">
                        <input type="checkbox" name="is_featured" value="1" <%= product.is_featured ? 'checked' : '' %>>
                        Jadikan produk unggulan
                    </label>
                    <p style="font-size:12px;color:#8a8088;margin-top:8px">Produk aktif tampil di katalog. Produk unggulan dapat diprioritaskan pada bagian katalog unggulan website.</p>
                </div>
            </div>

            <div style="margin-top:10px;">
                <button class="admin-btn" type="submit">
                    <i class="bi bi-save"></i> <%= action === 'edit' ? 'Simpan Perubahan' : 'Simpan Produk' %>
                </button>
            </div>
        </form>
    </div>

<% } else { %>
    <!-- ========================================== -->
    <!-- PRODUCT LIST & MANAGEMENT VIEW             -->
    <!-- Matches original admin/produk.php list     -->
    <!-- ========================================== -->
    <div class="admin-title">
        <div>
            <h1>Produk</h1>
            <p style="color:#777">Tambah dan kelola semua produk yang tampil di katalog.</p>
        </div>
        <a class="admin-btn" href="<%= page_url('admin/produk?action=create') %>">
            <i class="bi bi-plus-lg"></i> Tambah Produk
        </a>
    </div>

    <div class="admin-stats" style="grid-template-columns:repeat(3,1fr)">
        <div class="admin-stat">
            <i class="bi bi-box-seam"></i>
            <strong><%= totalProducts %></strong>
            <span>Total Produk</span>
        </div>
        <div class="admin-stat">
            <i class="bi bi-check-circle"></i>
            <strong><%= activeProducts %></strong>
            <span>Produk Aktif</span>
        </div>
        <div class="admin-stat">
            <i class="bi bi-star-fill"></i>
            <strong><%= featuredProducts %></strong>
            <span>Produk Unggulan</span>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom:18px">
        <form method="get" action="<%= page_url('admin/produk') %>" style="display:grid;grid-template-columns:minmax(220px,1fr) 180px 180px auto;gap:10px;align-items:end">
            <div class="admin-field">
                <label>Cari Produk</label>
                <input name="q" value="<%= search %>" placeholder="Nama, ID, atau kategori...">
            </div>
            <div class="admin-field">
                <label>Status</label>
                <select name="status">
                    <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>Semua Status</option>
                    <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Aktif</option>
                    <option value="inactive" <%= statusFilter === 'inactive' ? 'selected' : '' %>>Nonaktif</option>
                </select>
            </div>
            <div class="admin-field">
                <label>Unggulan</label>
                <select name="featured">
                    <option value="all" <%= featuredFilter === 'all' ? 'selected' : '' %>>Semua</option>
                    <option value="yes" <%= featuredFilter === 'yes' ? 'selected' : '' %>>Unggulan</option>
                    <option value="no" <%= featuredFilter === 'no' ? 'selected' : '' %>>Bukan Unggulan</option>
                </select>
            </div>
            <button class="admin-btn" type="submit"><i class="bi bi-search"></i> Cari</button>
        </form>
    </div>

    <div class="admin-card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px">
            <div style="font-weight:800;color:#18243a">Daftar Produk <span style="color:#9a8e96;font-weight:500">(<%= products.length %> ditampilkan)</span></div>
            <% if (search !== '' || statusFilter !== 'all' || featuredFilter !== 'all') { %>
                <a href="<%= page_url('admin/produk') %>" style="color:#d64a8a;text-decoration:none;font-size:13px;font-weight:700">Reset Filter</a>
            <% } %>
        </div>

        <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Produk</th>
                        <th>Kategori</th>
                        <th>Harga</th>
                        <th>Status</th>
                        <th>Unggulan</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                <% if (!products || products.length === 0) { %>
                    <tr><td colspan="6" style="text-align:center;padding:35px;color:#8b8088">Produk tidak ditemukan.</td></tr>
                <% } else { %>
                    <% products.forEach(function(p) { %>
                        <tr>
                            <td>
                                <div style="display:flex;gap:11px;align-items:center">
                                    <img class="admin-product-img" src="<%= product_image_url(p.image) %>" alt="<%= p.name %>" onerror="this.style.display='none'">
                                    <div>
                                        <strong><%= p.name %></strong>
                                        <div style="font-size:11px;color:#968c93"><%= p.id %></div>
                                        <% if (p.specifications) { %>
                                            <span style="display:inline-block;margin-top:2px;font-size:10px;background:#ffeef4;color:#c2185b;padding:1px 6px;border-radius:4px;font-weight:600">Ada Spesifikasi</span>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span style="display: inline-block; padding: 4px 8px; background: #fff5f9; border: 1px solid #f2dce7; border-radius: 6px; color: #6d626c; font-size: 11.5px; font-weight: 600;">
                                    <%= p.category %>
                                </span>
                            </td>
                            <td>
                                <strong style="color: #e11d64;"><%= format_rupiah(p.price) %></strong> 
                                <span style="font-size:12px;color:#8b8088;">/ <%= p.unit || 'pcs' %></span>
                            </td>
                            <td>
                                <span style="display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:<%= p.status === 'active' ? '#eaf8ef' : '#f4f1f3' %>;color:<%= p.status === 'active' ? '#287a47' : '#817982' %>;font-size:12px;font-weight:700">
                                    <i class="bi <%= p.status === 'active' ? 'bi-check-circle-fill' : 'bi-pause-circle-fill' %>"></i>
                                    <%= p.status === 'active' ? 'Aktif' : 'Nonaktif' %>
                                </span>
                            </td>
                            <td>
                                <form method="POST" action="<%= page_url('admin/produk') %>" style="display:inline">
                                    <input type="hidden" name="mode" value="featured">
                                    <input type="hidden" name="id" value="<%= p.id %>">
                                    <button type="submit" title="<%= p.is_featured ? 'Jadikan bukan unggulan' : 'Jadikan unggulan' %>" style="border:0;background:<%= p.is_featured ? '#fff4cf' : '#f7f4f5' %>;color:<%= p.is_featured ? '#b47b00' : '#9a9097' %>;padding:6px 10px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px">
                                        <i class="bi <%= p.is_featured ? 'bi-star-fill' : 'bi-star' %>"></i>
                                        <%= p.is_featured ? 'Unggulan' : 'Bukan' %>
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="admin-actions">
                                    <a href="<%= page_url('admin/produk?action=edit&id=' + encodeURIComponent(p.id)) %>"><i class="bi bi-pencil"></i> Edit</a>

                                    <form method="POST" action="<%= page_url('admin/produk') %>" style="display:inline">
                                        <input type="hidden" name="mode" value="toggle">
                                        <input type="hidden" name="id" value="<%= p.id %>">
                                        <button type="submit" style="border:0;background:#fff1f6;color:#d64a8a;padding:6px 10px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer">
                                            <i class="bi bi-power"></i> <%= p.status === 'active' ? 'Nonaktifkan' : 'Aktifkan' %>
                                        </button>
                                    </form>

                                    <form method="POST" action="<%= page_url('admin/produk') %>" style="display:inline" onsubmit="return confirm('Hapus produk \'<%= p.name.replace(/'/g, '\\\'') %>\'? Tindakan ini tidak dapat dibatalkan.');">
                                        <input type="hidden" name="mode" value="delete">
                                        <input type="hidden" name="id" value="<%= p.id %>">
                                        <button type="submit" style="border:0;background:#fff0f0;color:#b44141;padding:6px 10px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer">
                                            <i class="bi bi-trash"></i> Hapus
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>

<%- include('_footer') %>
