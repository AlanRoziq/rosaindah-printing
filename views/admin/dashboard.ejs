<%- include('_header', { title: 'Dashboard Ringkasan' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Dashboard Ringkasan</h2>
        <p class="text-muted mb-0">Gambaran kinerja operasional dan pesanan cetak Rosa Indah Printing hari ini.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="<%= page_url('admin/pesanan') %>" class="btn btn-outline-secondary">
            <i class="bi bi-cart-check"></i> Semua Pesanan
        </a>
        <a href="<%= page_url('admin/produk') %>" class="btn btn-primary" style="background: #d64a8a; border-color: #d64a8a;">
            <i class="bi bi-plus-lg"></i> Tambah Produk
        </a>
    </div>
</div>

<!-- Main Stats -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card-pink d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-light text-primary fs-3"><i class="bi bi-box-seam"></i></div>
            <div>
                <h3 class="fw-bold mb-0"><%= stats.products %></h3>
                <small class="text-muted">Total Produk Katalog</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card-pink d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-light text-success fs-3"><i class="bi bi-cart-check"></i></div>
            <div>
                <h3 class="fw-bold mb-0"><%= stats.orders %></h3>
                <small class="text-muted">Total Pesanan</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card-pink d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-light text-warning fs-3"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <h3 class="fw-bold mb-0"><%= stats.waiting_payment %></h3>
                <small class="text-muted">Menunggu Verifikasi</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card-pink d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-light text-info fs-3"><i class="bi bi-people"></i></div>
            <div>
                <h3 class="fw-bold mb-0"><%= stats.customers %></h3>
                <small class="text-muted">Member Terdaftar</small>
            </div>
        </div>
    </div>
</div>

<!-- Revenue Highlight -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card p-4 rounded-4 shadow-sm border-0 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle p-3 text-white fs-3" style="background: #d64a8a; width: 60px; height: 60px; display: grid; place-items: center;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <span class="text-muted small">Total Estimasi Omset:</span>
                    <h3 class="fw-bold text-dark mb-0"><%= format_rupiah(stats.month_sales) %></h3>
                    <small class="text-muted"><%= stats.orders %> transaksi pesanan tercatat</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4 rounded-4 shadow-sm border-0 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small">Alur Status Pesanan Saat Ini:</span>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="badge bg-warning text-dark">Baru: <%= stats.orderCounts.pending %></span>
                        <span class="badge bg-info text-dark">Dikonfirmasi: <%= stats.orderCounts.confirmed %></span>
                        <span class="badge bg-secondary">Diproses: <%= stats.orderCounts.processing %></span>
                        <span class="badge bg-primary">Dicetak: <%= stats.orderCounts.printed %></span>
                        <span class="badge bg-success">Selesai: <%= stats.orderCounts.completed %></span>
                    </div>
                </div>
                <a href="<%= page_url('admin/pesanan') %>" class="btn btn-sm btn-outline-primary">Kelola</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="card p-4 rounded-4 shadow-sm border-0 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Pesanan Masuk Terbaru</h4>
        <a href="<%= page_url('admin/pesanan') %>" class="small fw-bold text-decoration-none" style="color: #d64a8a;">Lihat Semua Pesanan →</a>
    </div>

    <% if (recent.length === 0) { %>
        <p class="text-muted my-3 text-center">Belum ada pesanan masuk.</p>
    <% } else { %>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nomor Order</th>
                        <th>Pelanggan</th>
                        <th>Total Estimasi</th>
                        <th>Status Order</th>
                        <th>Pembayaran</th>
                        <th>Waktu</th>
                    </tr>
                </thead>
                <tbody>
                    <% recent.forEach(function(o) { %>
                        <tr>
                            <td>
                                <a href="<%= page_url('admin/pesanan?code=' + o.order_code) %>" class="fw-bold text-dark text-decoration-none">
                                    <%= o.order_code %>
                                </a>
                            </td>
                            <td>
                                <div><%= o.customer_name %></div>
                                <small class="text-muted"><%= o.customer_phone %></small>
                            </td>
                            <td class="fw-bold text-danger"><%= format_rupiah(o.total_estimate) %></td>
                            <td>
                                <span class="status-pill status-pill-<%= o.status %>">
                                    <%= o.status.toUpperCase() %>
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-<%= o.payment_status === 'paid' ? 'success' : 'warning text-dark' %>">
                                    <%= o.payment_status %>
                                </span>
                            </td>
                            <td class="small text-muted"><%= o.created_at %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include('_footer') %>
