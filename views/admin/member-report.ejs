<%- include('_header', { title: 'Laporan Member & Loyalty' }) %>

<div class="admin-title">
    <div>
        <h1>Laporan Member, Promo & Loyalty</h1>
        <p>Ringkasan performa program member, promo voucher, loyalty reward, dan pusat notifikasi.</p>
    </div>
    <button class="admin-btn secondary" type="button" onclick="window.print()">
        <i class="bi bi-printer"></i> Cetak Laporan
    </button>
</div>

<!-- Stats Summary -->
<div class="admin-stats" style="grid-template-columns: repeat(3, 1fr);">
    <div class="admin-stat">
        <i class="bi bi-people"></i>
        <strong><%= customers.length %></strong>
        <span>Total Member Terdaftar</span>
    </div>
    <div class="admin-stat">
        <i class="bi bi-stars"></i>
        <strong><%= customers.reduce(function(sum, c) { return sum + (c.points || 0); }, 0) %></strong>
        <span>Total Saldo Poin Member</span>
    </div>
    <div class="admin-stat">
        <i class="bi bi-ticket-perforated"></i>
        <strong><%= promotions.length + vouchers.length %></strong>
        <span>Promo & Voucher Aktif</span>
    </div>
    <div class="admin-stat">
        <i class="bi bi-gift"></i>
        <strong><%= rewards.length %></strong>
        <span>Pilihan Reward Loyalty</span>
    </div>
    <div class="admin-stat">
        <i class="bi bi-arrow-left-right"></i>
        <strong><%= transactions.length %></strong>
        <span>Transaksi Mutasi Poin</span>
    </div>
    <div class="admin-stat">
        <i class="bi bi-bell"></i>
        <strong><%= notifications.length %></strong>
        <span>Total Pesan Broadcast</span>
    </div>
</div>

<div class="admin-grid-2">
    <!-- Loyalty Summary -->
    <div class="admin-card">
        <div style="margin-bottom: 16px;">
            <h2 style="margin: 0; color: #18243a; font-size: 18px; font-weight: 800;">Program Loyalty Member</h2>
            <p style="margin: 4px 0 0; color: #7d747c; font-size: 13px;">Katalog reward voucher dan poin reward yang dapat ditukar.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <% rewards.forEach(function(r) { %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; background: #fff8fb; border: 1px solid #f2dce7; border-radius: 12px;">
                    <div>
                        <strong style="color: #18243a; font-size: 13.5px;"><%= r.name %></strong>
                        <small style="display: block; color: #8c8289; font-size: 11.5px; margin-top: 2px;">
                            <%= r.discount_type === 'fixed' ? format_rupiah(r.discount_value) : r.discount_value + '%' %> diskon · Min order <%= format_rupiah(r.min_order) %>
                        </small>
                    </div>
                    <span style="padding: 5px 11px; border-radius: 999px; background: #fff0f6; border: 1px solid #f2dce7; color: #e11d64; font-weight: 800; font-size: 12px;">
                        <%= r.points_cost %> Poin
                    </span>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- Active Promos & Vouchers -->
    <div class="admin-card">
        <div style="margin-bottom: 16px;">
            <h2 style="margin: 0; color: #18243a; font-size: 18px; font-weight: 800;">Voucher & Kode Kupon</h2>
            <p style="margin: 4px 0 0; color: #7d747c; font-size: 13px;">Kode voucher aktif untuk transaksi cetak online.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <% vouchers.forEach(function(v) { %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; background: #fff8fb; border: 1px solid #f2dce7; border-radius: 12px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <code style="background: #ffe8f1; color: #e11d64; padding: 2px 7px; border-radius: 6px; font-weight: 800; font-size: 12px;"><%= v.code %></code>
                            <strong style="color: #18243a; font-size: 13px;"><%= v.name %></strong>
                        </div>
                        <small style="display: block; color: #8c8289; font-size: 11.5px; margin-top: 4px;">
                            <%= v.discount_type === 'fixed' ? format_rupiah(v.discount_value) : v.discount_value + '%' %> · Min <%= format_rupiah(v.min_order) %>
                        </small>
                    </div>
                    <span class="status-pill status-pill-completed">
                        <%= v.status %>
                    </span>
                </div>
            <% }); %>
            <% promotions.forEach(function(p) { %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; background: #fff8fb; border: 1px solid #f2dce7; border-radius: 12px;">
                    <div>
                        <strong style="color: #18243a; font-size: 13px;"><%= p.name %></strong>
                        <small style="display: block; color: #8c8289; font-size: 11.5px; margin-top: 2px;">
                            Diskon otomatis <%= p.discount_value %>%
                        </small>
                    </div>
                    <span class="status-pill status-pill-completed">
                        Otomatis
                    </span>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<!-- Top Members Table -->
<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 18px 22px; border-bottom: 1px solid #f2dce7; background: #fffcfd;">
        <h2 style="margin: 0; color: #18243a; font-size: 17px; font-weight: 800;">Peringkat & Loyalitas Member</h2>
    </div>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="admin-table" style="min-width: 820px;">
            <thead>
                <tr>
                    <th>Nama Member</th>
                    <th>Kontak WhatsApp</th>
                    <th>Email</th>
                    <th>Saldo Poin</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% customers.forEach(function(c) { %>
                    <tr>
                        <td>
                            <strong style="color: #18243a; font-size: 13.5px;"><%= c.name %></strong>
                        </td>
                        <td>
                            <a href="https://wa.me/<%= c.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener" style="color: #287a47; font-weight: 700; text-decoration: none; font-size: 12.5px;">
                                <i class="bi bi-whatsapp"></i> <%= c.phone %>
                            </a>
                        </td>
                        <td style="color: #696068; font-size: 12.5px;"><%= c.email || '-' %></td>
                        <td>
                            <strong style="color: #e11d64; font-size: 13.5px;">
                                <%= c.points || 0 %> Poin
                            </strong>
                        </td>
                        <td>
                            <span class="status-pill status-pill-completed">
                                Member Aktif
                            </span>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('_footer') %>
