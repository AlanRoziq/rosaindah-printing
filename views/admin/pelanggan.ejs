<%- include('_header', { title: 'Data Member' }) %>

<div class="admin-title">
    <div>
        <h1>Data Pelanggan & Member</h1>
        <p>Kelola data member terdaftar, kontak WhatsApp, dan saldo poin loyalitas.</p>
    </div>
</div>

<!-- Customer Stats -->
<div class="admin-stats" style="grid-template-columns: repeat(3, 1fr);">
    <div class="admin-stat">
        <i class="bi bi-people"></i>
        <strong><%= customers.length %></strong>
        <span>Total Member Terdaftar</span>
    </div>
    <div class="admin-stat">
        <i class="bi bi-stars"></i>
        <strong><%= customers.reduce(function(sum, c) { return sum + (c.points || 0); }, 0) %></strong>
        <span>Total Poin Beredar</span>
    </div>
    <div class="admin-stat">
        <i class="bi bi-patch-check"></i>
        <strong><%= customers.filter(function(c) { return c.is_verified; }).length %></strong>
        <span>Member Terverifikasi</span>
    </div>
</div>

<!-- Customers Table Card -->
<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="admin-table" style="min-width: 820px;">
            <thead>
                <tr>
                    <th>Nama Pelanggan</th>
                    <th>Nomor WhatsApp</th>
                    <th>Email</th>
                    <th>Alamat Domisili</th>
                    <th>Poin Loyalty</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% customers.forEach(function(c) { %>
                    <tr>
                        <td>
                            <strong style="color: #18243a; font-size: 13.5px;"><%= c.name %></strong>
                        </td>
                        <td>
                            <a href="https://wa.me/<%= c.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 5px; color: #287a47; font-weight: 700; text-decoration: none; font-size: 12.5px;">
                                <i class="bi bi-whatsapp"></i> <%= c.phone %>
                            </a>
                        </td>
                        <td style="color: #6d646c; font-size: 12.5px;"><%= c.email || '-' %></td>
                        <td style="color: #7b727a; font-size: 12.5px; max-width: 220px;"><%= c.address || '-' %></td>
                        <td>
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 999px; background: #fff0f6; border: 1px solid #f2dce7; color: #e11d64; font-weight: 800; font-size: 12px;">
                                <i class="bi bi-stars"></i> <%= c.points || 0 %> Poin
                            </span>
                        </td>
                        <td>
                            <span class="status-pill status-pill-completed">
                                Terverifikasi
                            </span>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('_footer') %>
