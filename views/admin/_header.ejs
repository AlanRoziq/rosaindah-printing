<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Admin - Rosa Indah Printing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="<%= asset_url('css/admin.css') %>">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #fbf7f9; }
        .admin-sidebar { min-height: 100vh; background: #1a1622; color: #fff; width: 250px; flex-shrink: 0; }
        .admin-sidebar a { color: #b6b0c2; text-decoration: none; padding: 12px 20px; display: flex; align-items: center; gap: 12px; font-weight: 500; border-radius: 8px; margin: 4px 12px; }
        .admin-sidebar a:hover, .admin-sidebar a.active { color: #fff; background: #d64a8a; }
        .admin-header-bar { background: #fff; border-bottom: 1px solid #f0e6ec; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
        .admin-content-area { padding: 30px; flex-grow: 1; }
        .stat-card-pink { background: #fff; border: 1px solid #f5e4ed; border-radius: 14px; padding: 20px; }
        .status-pill { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .status-pill-pending { background: #fff3cd; color: #856404; }
        .status-pill-confirmed { background: #cce5ff; color: #004085; }
        .status-pill-processing { background: #e2e3e5; color: #383d41; }
        .status-pill-printed { background: #d4edda; color: #155724; }
        .status-pill-completed { background: #28a745; color: #fff; }
        .status-pill-cancelled { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body class="d-flex">
    <!-- Sidebar -->
    <aside class="admin-sidebar d-flex flex-column">
        <div class="p-3 border-bottom border-secondary mb-2 text-center">
            <h5 class="fw-bold text-white mb-0" style="letter-spacing: 1px;">ROSA INDAH</h5>
            <small style="color: #f48fb1;">ADMIN DASHBOARD</small>
        </div>
        <nav class="flex-grow-1">
            <a href="<%= page_url('admin/dashboard') %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="<%= page_url('admin/pesanan') %>"><i class="bi bi-cart-check"></i> Kelola Pesanan</a>
            <a href="<%= page_url('admin/produk') %>"><i class="bi bi-box-seam"></i> Produk & Katalog</a>
            <a href="<%= page_url('admin/laporan') %>"><i class="bi bi-bar-chart-line"></i> Laporan Penjualan</a>
            <a href="<%= page_url('admin/pelanggan') %>"><i class="bi bi-people"></i> Data Member</a>
            <hr class="border-secondary mx-3 my-2">
            <a href="<%= page_url('') %>" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Lihat Website</a>
        </nav>
        <div class="p-3 border-top border-secondary">
            <a href="<%= page_url('admin/logout') %>" class="text-danger m-0 p-2"><i class="bi bi-box-arrow-right"></i> Logout Admin</a>
        </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="d-flex flex-column flex-grow-1" style="min-width: 0;">
        <header class="admin-header-bar">
            <div>
                <h5 class="mb-0 fw-bold text-dark">Panel Kontrol Operasional</h5>
                <small class="text-muted">Rosa Indah Printing Pasuruan</small>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-light text-dark border p-2"><i class="bi bi-shield-check text-success"></i> <%= currentAdmin ? currentAdmin.name : 'Admin' %></span>
                <a href="<%= page_url('') %>" class="btn btn-sm btn-outline-secondary">Website Publik</a>
            </div>
        </header>
        <main class="admin-content-area">
