<%- include('partials/header', { title: 'Lacak Status Pesanan' }) %>

<header class="main-header">
    <%- include('partials/topbar') %>
    <%- include('partials/navbar') %>
</header>

<main class="tracking-page py-4">
    <div class="container">
        <!-- Breadcrumb -->
        <div class="catalog-breadcrumb mb-4">
            <a href="<%= page_url('') %>">Home</a>
            <i class="bi bi-chevron-right"></i>
            <span>Lacak Pesanan</span>
        </div>

        <div class="tracking-header text-center max-w-600 mx-auto mb-4">
            <h1 class="h2 fw-bold">Pelacakan Pesanan Real-Time</h1>
            <p class="text-muted">Pantau posisi pengerjaan pesanan percetakan Anda secara langsung menggunakan nomor pesanan dan WhatsApp.</p>
        </div>

        <% if (isNew) { %>
            <div class="alert alert-success alert-dismissible fade show max-w-700 mx-auto mb-4" role="alert">
                <h5 class="alert-heading fw-bold mb-1"><i class="bi bi-check-circle-fill me-2"></i> Pesanan Berhasil Dibuat!</h5>
                <p class="mb-0">Nomor pesanan Anda adalah <strong><%= code %></strong>. Simpan nomor ini untuk melacak proses pengerjaan dan konfirmasi pembayaran.</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger max-w-700 mx-auto mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill me-2"></i> <%= error %>
            </div>
        <% } %>

        <!-- Search Form -->
        <div class="card p-4 rounded-4 shadow-sm border-0 max-w-700 mx-auto mb-5">
            <form action="<%= page_url('lacak-pesanan') %>" method="GET" class="row g-3">
                <div class="col-md-6">
                    <label for="code" class="form-label fw-bold small text-secondary">Nomor Pesanan (Order Code):</label>
                    <input type="text" class="form-control text-uppercase" id="code" name="code" placeholder="Contoh: RIP-20260320-1045" value="<%= code %>" required>
                </div>
                <div class="col-md-6">
                    <label for="phone" class="form-label fw-bold small text-secondary">Nomor WhatsApp Pemesan:</label>
                    <input type="text" class="form-control" id="phone" name="phone" placeholder="Contoh: 081234567890" value="<%= phone %>">
                </div>
                <div class="col-12 text-center mt-3">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="bi bi-search me-1"></i> Lacak Status Sekarang
                    </button>
                    <div class="small text-muted mt-2">
                        Contoh order demo untuk dicoba: <code>RIP-20260320-1045</code> (WA: <code>081234567890</code>)
                    </div>
                </div>
            </form>
        </div>

        <% if (order) { %>
            <% 
                const steps = [
                    { id: 'pending', label: 'Baru Dibuat', icon: 'bi-clipboard' },
                    { id: 'confirmed', label: 'Dikonfirmasi', icon: 'bi-check-circle' },
                    { id: 'processing', label: 'Desain / Cetak', icon: 'bi-printer' },
                    { id: 'printed', label: 'Finishing / Siap', icon: 'bi-box-seam' },
                    { id: 'completed', label: 'Selesai / Terkirim', icon: 'bi-bag-check' }
                ];
                const statusOrder = ['pending', 'confirmed', 'processing', 'printed', 'completed'];
                const currentIdx = statusOrder.indexOf(order.status);
            %>

            <div class="card p-4 p-md-5 rounded-4 shadow-sm border-0 max-w-900 mx-auto">
                <!-- Order Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <div>
                        <span class="text-muted small">Nomor Pesanan:</span>
                        <h3 class="fw-bold text-dark mb-0"><%= order.order_code %></h3>
                        <small class="text-secondary"><i class="bi bi-clock"></i> <%= order.created_at %> WIB</small>
                    </div>
                    <div class="text-end mt-2 mt-sm-0">
                        <span class="badge bg-<%= order.status === 'completed' ? 'success' : (order.status === 'cancelled' ? 'danger' : 'primary') %> fs-6 px-3 py-2">
                            Status: <%= order.status.toUpperCase() %>
                        </span>
                        <div class="mt-1 small">
                            Pembayaran: 
                            <span class="badge bg-<%= order.payment_status === 'paid' ? 'success' : (order.payment_status === 'waiting' ? 'warning text-dark' : 'danger') %>">
                                <%= order.payment_status === 'paid' ? 'LUNAS' : (order.payment_status === 'waiting' ? 'MENUNGGU VERIFIKASI' : 'BELUM BAYAR') %>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Timeline Steps -->
                <div class="tracking-progress-wrapper my-4">
                    <div class="d-flex justify-content-between position-relative">
                        <div class="progress position-absolute top-50 start-0 w-100" style="height: 4px; z-index: 1; transform: translateY(-50%);">
                            <div class="progress-bar bg-success" role="progressbar" style="width: <%= Math.max(0, currentIdx) * 25 %>%;"></div>
                        </div>
                        <% steps.forEach(function(st, idx) { 
                            const isDone = currentIdx >= idx;
                            const isCurrent = currentIdx === idx;
                        %>
                            <div class="text-center position-relative" style="z-index: 2;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 text-white <%= isDone ? 'bg-success' : 'bg-light border text-muted' %>" 
                                     style="width: 44px; height: 44px; font-size: 18px;">
                                    <i class="bi <%= st.icon %>"></i>
                                </div>
                                <span class="d-block small fw-bold <%= isCurrent ? 'text-primary' : (isDone ? 'text-dark' : 'text-muted') %>"><%= st.label %></span>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <!-- Order Details & Payment -->
                <div class="row g-4 mt-3">
                    <div class="col-md-7">
                        <h5 class="fw-bold mb-3"><i class="bi bi-basket text-primary me-2"></i> Daftar Produk Pesanan</h5>
                        <div class="border rounded-3 p-3 bg-light">
                            <% order.items.forEach(function(item) { %>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <div>
                                        <div class="fw-bold"><%= item.product_name %></div>
                                        <small class="text-muted"><%= item.quantity %> <%= item.unit %> × <%= format_rupiah(item.unit_price) %></small>
                                    </div>
                                    <div class="fw-semibold text-danger"><%= format_rupiah(item.subtotal) %></div>
                                </div>
                            <% }); %>
                            <% if (order.discount_amount > 0) { %>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom text-success">
                                    <div>Diskon Promo (<%= order.voucher_code %>)</div>
                                    <div>- <%= format_rupiah(order.discount_amount) %></div>
                                </div>
                            <% } %>
                            <div class="d-flex justify-content-between align-items-center pt-3 fw-bold fs-5">
                                <div>Total Estimasi:</div>
                                <div class="text-danger"><%= format_rupiah(order.total_estimate) %></div>
                            </div>
                        </div>

                        <% if (order.customer_note) { %>
                            <div class="mt-3 p-3 bg-white border rounded-3">
                                <small class="text-muted fw-bold d-block">Catatan Pemesan:</small>
                                <span><%= order.customer_note %></span>
                            </div>
                        <% } %>
                    </div>

                    <div class="col-md-5">
                        <h5 class="fw-bold mb-3"><i class="bi bi-wallet2 text-primary me-2"></i> Informasi Pembayaran</h5>
                        <div class="p-3 border rounded-3 bg-white mb-3">
                            <small class="text-muted d-block">Metode Pembayaran:</small>
                            <span class="fw-bold text-uppercase"><%= order.payment_method %></span>
                            
                            <hr class="my-2">
                            <small class="text-muted d-block">Rekening Transfer:</small>
                            <div class="fw-semibold text-dark">BCA: <code>1234-5678-90</code></div>
                            <div class="small text-muted">a.n. Rosa Indah Printing</div>
                        </div>

                        <!-- Upload Proof Form -->
                        <div class="p-3 border rounded-3 bg-light">
                            <h6 class="fw-bold mb-2">Konfirmasi Bukti Pembayaran</h6>
                            <% if (order.payment_status === 'paid') { %>
                                <div class="text-success small fw-semibold">
                                    <i class="bi bi-check-circle-fill"></i> Pembayaran telah diverifikasi lunas oleh admin.
                                </div>
                            <% } else { %>
                                <p class="small text-muted mb-2">Upload bukti transfer atau resi pembayaran agar pesanan segera masuk tahap cetak.</p>
                                <form action="<%= page_url('pembayaran') %>" method="POST">
                                    <input type="hidden" name="order_code" value="<%= order.order_code %>">
                                    <input type="hidden" name="customer_phone" value="<%= order.customer_phone %>">
                                    <div class="mb-2">
                                        <input type="file" class="form-control form-control-sm" name="proof">
                                    </div>
                                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="bi bi-upload me-1"></i> Kirim Bukti Bayar
                                    </button>
                                </form>
                            <% } %>
                        </div>

                        <div class="mt-3 text-center">
                            <a href="https://wa.me/<%= whatsapp_number %>?text=Halo%20Rosa%20Indah%20Printing,%20konfirmasi%20pesanan%20<%= order.order_code %>" 
                               target="_blank" rel="noopener" class="btn btn-success btn-sm w-100">
                                <i class="bi bi-whatsapp me-1"></i> Konfirmasi via WhatsApp
                            </a>
                        </div>
                    </div>
                </div>

                <!-- History Log -->
                <% if (order.history && order.history.length > 0) { %>
                    <hr class="my-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary me-2"></i> Riwayat Aktivitas Pesanan</h5>
                    <ul class="list-group list-group-flush">
                        <% order.history.forEach(function(h) { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <span class="badge bg-secondary me-2"><%= h.status %></span>
                                    <span><%= h.note %></span>
                                </div>
                                <small class="text-muted"><%= h.created_at %></small>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        <% } %>
    </div>
</main>

<style>
.max-w-600 { max-width: 600px; }
.max-w-700 { max-width: 700px; }
.max-w-900 { max-width: 900px; }
</style>

<%- include('partials/footer') %>
