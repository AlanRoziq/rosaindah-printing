<%- include('partials/header', { title: 'Keranjang Belanja' }) %>

<header class="main-header">
    <%- include('partials/topbar') %>
    <%- include('partials/navbar') %>
</header>

<main class="cart-page py-4">
    <div class="container">
        <!-- Breadcrumb -->
        <div class="catalog-breadcrumb mb-4">
            <a href="<%= page_url('') %>">Home</a>
            <i class="bi bi-chevron-right"></i>
            <span>Keranjang Belanja</span>
        </div>

        <div class="cart-header mb-4">
            <h1 class="h2 fw-bold">Keranjang Belanja Anda</h1>
            <p class="text-muted">Periksa kembali rincian produk cetak sebelum melanjutkan proses checkout.</p>
        </div>

        <% if (notice) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= notice %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (items.length === 0) { %>
            <div class="empty-cart text-center p-5 bg-white rounded-4 shadow-sm my-4">
                <i class="bi bi-bag-x display-3 text-muted"></i>
                <h3 class="mt-3">Keranjang Belanja Masih Kosong</h3>
                <p class="text-muted">Anda belum menambahkan produk cetak ke dalam keranjang.</p>
                <a href="<%= page_url('produk') %>" class="btn btn-primary mt-2">Mulai Belanja Sekarang</a>
            </div>
        <% } else { %>
            <div class="row g-4">
                <!-- Cart Items Table -->
                <div class="col-lg-8">
                    <div class="bg-white p-4 rounded-4 shadow-sm">
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produk</th>
                                        <th>Harga Satuan</th>
                                        <th style="width: 140px;">Jumlah</th>
                                        <th>Subtotal</th>
                                        <th>Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% items.forEach(function(item) { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="<%= product_image_url(item.product.image) %>" alt="<%= item.product.name %>" style="width: 60px; height: 60px; object-fit: cover;" class="rounded border">
                                                    <div>
                                                        <a href="<%= page_url('detail-produk?id=' + item.product.id) %>" class="text-decoration-none text-dark fw-bold d-block"><%= item.product.name %></a>
                                                        <small class="badge bg-light text-secondary border"><%= item.product.category %></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-secondary"><%= format_rupiah(item.unitPrice) %> <small>/ <%= item.product.unit %></small></td>
                                            <td>
                                                <form action="<%= page_url('cart') %>" method="POST" class="d-flex align-items-center gap-1">
                                                    <input type="hidden" name="action" value="update">
                                                    <input type="hidden" name="product_id" value="<%= item.product.id %>">
                                                    <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="100000" class="form-control form-control-sm text-center" style="width: 70px;">
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Update"><i class="bi bi-arrow-repeat"></i></button>
                                                </form>
                                            </td>
                                            <td class="fw-bold text-danger"><%= format_rupiah(item.subtotal) %></td>
                                            <td>
                                                <form action="<%= page_url('cart') %>" method="POST" onsubmit="return confirm('Hapus produk ini dari keranjang?');">
                                                    <input type="hidden" name="action" value="remove">
                                                    <input type="hidden" name="product_id" value="<%= item.product.id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <a href="<%= page_url('produk') %>" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Lanjut Belanja
                            </a>
                            <form action="<%= page_url('cart') %>" method="POST" onsubmit="return confirm('Kosongkan semua item di keranjang?');">
                                <input type="hidden" name="action" value="clear">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Kosongkan Keranjang</button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="col-lg-4">
                    <div class="bg-white p-4 rounded-4 shadow-sm">
                        <h4 class="fw-bold mb-3">Ringkasan Belanja</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Barang</span>
                            <span class="fw-bold"><%= items.reduce((a, b) => a + b.quantity, 0) %> item</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold"><%= format_rupiah(total) %></span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-5">Estimasi Total</span>
                            <span class="fw-bold fs-5 text-danger"><%= format_rupiah(total) %></span>
                        </div>

                        <a href="<%= page_url('checkout') %>" class="btn btn-primary btn-lg w-100 mb-2">
                            Lanjut ke Checkout <i class="bi bi-arrow-right"></i>
                        </a>
                        <small class="text-muted d-block text-center">Harga transparan & dapat dikonsultasikan via WhatsApp.</small>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
