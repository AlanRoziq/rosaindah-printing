<style>
@media (min-width: 768px) {
  nav.custom-navbar .right-menu a.cart-nav-btn,
  .custom-navbar .right-menu .cart-nav-btn,
  .custom-navbar .cart-nav-btn {
    display: inline-flex !important;
  }
}
@media (max-width: 767.98px) {
  nav.custom-navbar .right-menu a.cart-nav-btn,
  .custom-navbar .right-menu .cart-nav-btn,
  .custom-navbar .cart-nav-btn,
  .right-menu .cart-nav-btn,
  .cart-nav-btn {
    display: none !important;
  }
}
.notif-dropdown-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.custom-navbar .notification-nav-btn,
.custom-navbar .right-menu .notification-nav-btn,
.notification-nav-btn {
  width: 38px !important;
  height: 38px !important;
  flex: 0 0 38px !important;
  border-radius: 50% !important;
  border: 1px solid #fbcfe8 !important;
  background: #fff0f5 !important;
  color: #e11d64 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-decoration: none !important;
  position: relative !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
  font-size: 16px !important;
  padding: 0 !important;
  box-shadow: 0 2px 8px rgba(225, 29, 100, 0.08) !important;
}
.custom-navbar .notification-nav-btn:hover,
.custom-navbar .notification-nav-btn.active,
.notification-nav-btn:hover,
.notification-nav-btn.active {
  background: #e11d64 !important;
  border-color: #e11d64 !important;
  color: #ffffff !important;
}
.custom-navbar .notification-nav-btn:hover i,
.custom-navbar .notification-nav-btn.active i {
  color: #ffffff !important;
}
.notif-badge-dot {
  position: absolute !important;
  top: -4px !important;
  right: -4px !important;
  min-width: 18px !important;
  height: 18px !important;
  padding: 0 4px !important;
  background: #e11d64 !important;
  color: #ffffff !important;
  font-size: 10px !important;
  font-weight: 800 !important;
  border-radius: 999px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: 2px solid #ffffff !important;
  line-height: 1 !important;
  box-shadow: 0 2px 6px rgba(225, 29, 100, 0.3) !important;
}
.notif-dropdown-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.28);
  backdrop-filter: blur(1.5px);
  z-index: 2147483645;
}
.notif-dropdown-backdrop.show {
  display: block;
}
.notif-dropdown-menu {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;
  width: 345px;
  max-width: calc(100vw - 20px);
  background: #ffffff;
  border: 1.5px solid #f2dce7;
  border-radius: 20px;
  box-shadow: 0 20px 48px rgba(24, 36, 58, 0.22);
  z-index: 2147483650;
  display: none;
  overflow: hidden;
  text-align: left;
}
.notif-dropdown-menu.show {
  display: block !important;
  animation: notifPopIn 0.18s ease-out;
}
@keyframes notifPopIn {
  from {
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
.notif-dropdown-header {
  padding: 13px 16px;
  background: linear-gradient(135deg, #fff0f6 0%, #ffffff 100%);
  border-bottom: 1px solid #f2dce7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.notif-dropdown-header strong {
  font-size: 13.5px;
  font-weight: 800;
  color: #18243a;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.notif-dropdown-close {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 1px solid #f2dce7;
  background: #ffffff;
  color: #6f626b;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  cursor: pointer;
  padding: 0;
  line-height: 1;
}
.notif-dropdown-close:hover {
  background: #fff0f6;
  color: #e11d64;
}
.notif-dropdown-list {
  max-height: 330px;
  overflow-y: auto;
  background: #ffffff;
}
.notif-dropdown-item {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 12px 15px;
  border-bottom: 1px solid #f8eef3;
  text-decoration: none;
  transition: background 0.15s ease;
}
.notif-dropdown-item:hover {
  background: #fff5f9;
}
.notif-dropdown-item.unread {
  background: #fff9fc;
}
.notif-item-icon {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
  margin-top: 1px;
}
.notif-item-body {
  flex: 1;
  min-width: 0;
}
.notif-item-title {
  font-size: 12.5px;
  font-weight: 800;
  color: #18243a;
  margin-bottom: 2px;
  line-height: 1.35;
}
.notif-item-msg {
  font-size: 11.5px;
  color: #6f626b;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.notif-dropdown-footer {
  padding: 11px 16px;
  background: #fffafc;
  text-align: center;
  border-top: 1px solid #f3e2eb;
}
.notif-dropdown-footer a {
  font-size: 12.5px;
  font-weight: 800;
  color: #e11d64;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
@media (max-width: 991.98px) {
  .custom-navbar .notification-nav-btn,
  .custom-navbar .right-menu .notification-nav-btn,
  .notification-nav-btn {
    width: 31px !important;
    height: 31px !important;
    flex: 0 0 31px !important;
    font-size: 14px !important;
  }
  .notif-badge-dot {
    top: -3px !important;
    right: -3px !important;
    min-width: 16px !important;
    height: 16px !important;
    font-size: 9px !important;
  }
  .notif-dropdown-menu {
    position: fixed !important;
    top: var(--notif-top, 102px) !important;
    left: 10px !important;
    right: 10px !important;
    width: auto !important;
    max-width: none !important;
    border-radius: 18px !important;
    z-index: 2147483650 !important;
    box-shadow: 0 22px 50px rgba(15, 23, 42, 0.28) !important;
  }
  .notif-dropdown-list {
    max-height: 58vh !important;
  }
}
@media (max-width: 390px) {
  .custom-navbar .notification-nav-btn,
  .custom-navbar .right-menu .notification-nav-btn,
  .notification-nav-btn {
    width: 29px !important;
    height: 29px !important;
    flex: 0 0 29px !important;
  }
}
</style>
<nav class="navbar navbar-expand-lg custom-navbar">
    <div class="container">
        <a class="navbar-brand" href="<%= page_url('') %>">
            <div class="logo-box">
                <img src="<%= asset_url('images/logo/logori.png') %>" alt="Rosa Indah Printing">
                <div class="brand-text">
                    <h2>ROSA INDAH</h2>
                    <h3>-PRINTING-</h3>
                    <p>CETAK IDE JADI KENYATAAN</p>
                </div>
            </div>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Buka menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-center" id="menu">
            <ul class="navbar-nav align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link" href="<%= page_url('') %>">Home</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="<%= page_url('produk') %>" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Produk
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="<%= page_url('produk') %>">Semua Produk</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <% categories.forEach(function(cat) { %>
                            <li><a class="dropdown-item" href="<%= page_url('produk?kategori=' + encodeURIComponent(cat)) %>"><%= cat %></a></li>
                        <% }); %>
                    </ul>
                </li>
                <li class="nav-item"><a class="nav-link" href="<%= page_url('portfolio') %>"><i class="bi bi-images"></i> Portofolio</a></li>
                <li class="nav-item"><a class="nav-link" href="<%= page_url('promo') %>"><i class="bi bi-ticket-perforated"></i> Promo Member</a></li>
                <li class="nav-item"><a class="nav-link" href="<%= page_url('tentang') %>">Tentang Kami</a></li>
                <li class="nav-item"><a class="nav-link" href="<%= page_url('cara-pemesanan') %>">Cara Pemesanan</a></li>
                <li class="nav-item"><a class="nav-link" href="<%= page_url('kontak') %>">Kontak</a></li>
                <li class="nav-item"><a class="nav-link" href="<%= page_url('lacak-pesanan') %>"><i class="bi bi-geo-alt"></i> Lacak Pesanan</a></li>
            </ul>
        </div>

        <div class="right-menu">
            <a href="<%= page_url('produk') %>" class="search-btn" aria-label="Cari produk" title="Cari produk">
                <i class="bi bi-search"></i>
            </a>
            <a href="<%= page_url('cart') %>" class="cart-nav-btn d-none d-md-inline-flex" aria-label="Keranjang belanja" title="Keranjang Belanja">
                <i class="bi bi-bag"></i>
                <% if (cart_count > 0) { %>
                    <span class="cart-nav-count"><%= cart_count %></span>
                <% } %>
            </a>
            <% if (currentUser) { %>
                <%
                    const navNotifs = (typeof navNotifications !== 'undefined' && Array.isArray(navNotifications)) ? navNotifications : [];
                    const navUnreadCount = (typeof navUnreadNotifCount !== 'undefined') ? Number(navUnreadNotifCount || 0) : 0;
                    const navAvatarSrc = currentUser.avatar ? (currentUser.avatar.startsWith('data:image/') || currentUser.avatar.startsWith('http') ? currentUser.avatar : '/' + currentUser.avatar.replace(/^\/+/, '')) : '';
                %>
                <div class="notif-dropdown-wrap" id="navNotifWrap">
                    <button type="button" class="notification-nav-btn" id="navNotifBtn" aria-label="Notifikasi Member" aria-expanded="false" title="Notifikasi Pesanan & Promo">
                        <i class="bi bi-bell"></i>
                        <% if (navUnreadCount > 0) { %>
                            <span class="notif-badge-dot"><%= navUnreadCount > 99 ? '99+' : navUnreadCount %></span>
                        <% } %>
                    </button>
                    <div class="notif-dropdown-backdrop" id="navNotifBackdrop"></div>
                    <div class="notif-dropdown-menu" id="navNotifMenu" role="dialog" aria-label="Notifikasi Member">
                        <div class="notif-dropdown-header">
                            <strong><i class="bi bi-bell-fill text-rosa"></i> Notifikasi Member</strong>
                            <div class="d-flex align-items-center gap-2">
                                <% if (navUnreadCount > 0) { %>
                                    <span style="background:#ffe4ef;color:#e11d64;font-size:10.5px;font-weight:800;padding:3px 8px;border-radius:999px;"><%= navUnreadCount %> Baru</span>
                                <% } %>
                                <button type="button" class="notif-dropdown-close" id="navNotifCloseBtn" aria-label="Tutup Notifikasi">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="notif-dropdown-list">
                            <% if (navNotifs.length === 0) { %>
                                <div style="padding:24px 16px;text-align:center;color:#8c7f88;font-size:12.5px;">
                                    <i class="bi bi-bell-slash d-block mb-1" style="font-size:22px;color:#d6b8c7;"></i>
                                    Belum ada notifikasi pesanan atau promo.
                                </div>
                            <% } else { %>
                                <% navNotifs.slice(0, 6).forEach(function(nf) {
                                    const nfType = String(nf.type || 'info');
                                    let nfIcon = 'bi-megaphone-fill';
                                    let nfBg = '#fff0f6';
                                    let nfColor = '#e11d64';
                                    let nfLabel = 'Info Seller';
                                    let nfLink = nf.link || page_url('akun?tab=notifikasi#pusatNotifikasi');
                                    if (nfType === 'order' || nfType === 'status') {
                                        nfIcon = 'bi-box-seam-fill';
                                        nfBg = '#eef6ff';
                                        nfColor = '#1d4ed8';
                                        nfLabel = 'Status Pesanan';
                                        if (!nf.link) nfLink = page_url('akun?tab=pesanan');
                                    } else if (nfType === 'payment') {
                                        nfIcon = 'bi-credit-card-2-front-fill';
                                        nfBg = '#e8f8ef';
                                        nfColor = '#15803d';
                                        nfLabel = 'Pembayaran';
                                        if (!nf.link) nfLink = page_url('akun?tab=pesanan');
                                    } else if (nfType === 'reward' || nfType === 'points' || nfType === 'bonus') {
                                        nfIcon = 'bi-star-fill';
                                        nfBg = '#fff9df';
                                        nfColor = '#b45309';
                                        nfLabel = 'Poin & Reward';
                                        if (!nf.link) nfLink = page_url('akun?tab=poin');
                                    } else if (nfType === 'promo' || nfType === 'voucher') {
                                        nfIcon = 'bi-ticket-perforated-fill';
                                        nfBg = '#fff0f6';
                                        nfColor = '#e11d64';
                                        nfLabel = 'Voucher Promo';
                                        if (!nf.link) nfLink = page_url('akun?tab=poin');
                                    }
                                %>
                                    <a href="<%= nfLink %>" class="notif-dropdown-item <%= !nf.is_read ? 'unread' : '' %>">
                                        <div class="notif-item-icon" style="background:<%= nfBg %>;color:<%= nfColor %>;">
                                            <i class="bi <%= nfIcon %>"></i>
                                        </div>
                                        <div class="notif-item-body">
                                            <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:3px;">
                                                <span style="background:<%= nfBg %>;color:<%= nfColor %>;font-size:9.5px;font-weight:800;padding:1.5px 7px;border-radius:999px;"><%= nfLabel %></span>
                                                <% if (nf.created_at) { %>
                                                    <span style="font-size:10px;color:#9ca3af;font-weight:600;"><%= new Date(nf.created_at).toLocaleString('id-ID', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
                                                <% } %>
                                            </div>
                                            <div class="notif-item-title"><%= nf.title || 'Info Rosa Indah' %></div>
                                            <div class="notif-item-msg"><%= nf.message || '' %></div>
                                        </div>
                                    </a>
                                <% }); %>
                            <% } %>
                        </div>
                        <div class="notif-dropdown-footer">
                            <a href="<%= page_url('akun?tab=notifikasi#pusatNotifikasi') %>">
                                <span>Buka Pusat Notifikasi Member</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <a href="<%= page_url('akun') %>" class="login-btn" title="Akun Saya">
                    <img id="navAvatarImg" src="<%= navAvatarSrc %>" alt="<%= currentUser.name %>" style="width: 22px; height: 22px; border-radius: 50%; object-fit: cover; border: 1.5px solid #ffffff; <%= navAvatarSrc ? 'display: inline-block;' : 'display: none;' %>" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-block';">
                    <i id="navAvatarIcon" class="bi bi-person-circle" style="<%= navAvatarSrc ? 'display: none;' : 'display: inline-block;' %>"></i>
                    <span><%= currentUser.name.split(' ')[0] %></span>
                </a>
                <script>
                (function() {
                    var btn = document.getElementById('navNotifBtn');
                    var menu = document.getElementById('navNotifMenu');
                    var backdrop = document.getElementById('navNotifBackdrop');
                    var closeBtn = document.getElementById('navNotifCloseBtn');
                    var wrap = document.getElementById('navNotifWrap');
                    if (!btn || !menu || !wrap) return;

                    function syncNotifPlacement() {
                        var isMobile = window.innerWidth <= 991.98;
                        var header = document.querySelector('.main-header') || document.querySelector('.custom-navbar');
                        if (isMobile) {
                            if (backdrop && backdrop.parentElement !== document.body) {
                                document.body.appendChild(backdrop);
                            }
                            if (menu.parentElement !== document.body) {
                                document.body.appendChild(menu);
                            }
                            var topPx = 98;
                            if (header) {
                                var rect = header.getBoundingClientRect();
                                if (rect && rect.bottom > 40) {
                                    topPx = Math.round(rect.bottom + 8);
                                }
                            }
                            menu.style.setProperty('--notif-top', topPx + 'px');
                        } else {
                            if (backdrop) backdrop.classList.remove('show');
                            if (menu.parentElement !== wrap) {
                                wrap.appendChild(menu);
                            }
                            menu.style.removeProperty('--notif-top');
                        }
                    }

                    function closeNotifMenu() {
                        menu.classList.remove('show');
                        btn.classList.remove('active');
                        btn.setAttribute('aria-expanded', 'false');
                        if (backdrop) backdrop.classList.remove('show');
                    }

                    function openNotifMenu() {
                        syncNotifPlacement();
                        var navCollapse = document.getElementById('menu');
                        if (navCollapse && navCollapse.classList.contains('show')) {
                            navCollapse.classList.remove('show');
                        }
                        menu.classList.add('show');
                        btn.classList.add('active');
                        btn.setAttribute('aria-expanded', 'true');
                        if (backdrop && window.innerWidth <= 991.98) {
                            backdrop.classList.add('show');
                        }
                    }

                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        if (menu.classList.contains('show')) {
                            closeNotifMenu();
                        } else {
                            openNotifMenu();
                        }
                    });

                    if (closeBtn) {
                        closeBtn.addEventListener('click', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            closeNotifMenu();
                        });
                    }

                    if (backdrop) {
                        backdrop.addEventListener('click', function() {
                            closeNotifMenu();
                        });
                    }

                    document.addEventListener('click', function(e) {
                        if (!menu.classList.contains('show')) return;
                        if (wrap.contains(e.target) || menu.contains(e.target)) return;
                        closeNotifMenu();
                    });

                    window.addEventListener('resize', function() {
                        if (menu.classList.contains('show')) {
                            syncNotifPlacement();
                        }
                    });
                })();
                </script>
            <% } else { %>
                <a href="<%= page_url('login') %>" class="login-btn" title="Login Member">
                    <i class="bi bi-person"></i>
                    <span class="login-label-text">Login Member</span>
                </a>
            <% } %>
        </div>
    </div>
</nav>
