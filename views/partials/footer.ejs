<footer class="bg-dark text-white text-center p-4 mt-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div class="text-start">
                <h5 class="text-white mb-1 fw-bold">Rosa Indah Printing</h5>
                <small class="text-secondary">Cetak Ide Jadi Kenyataan • Solusi Percetakan Online Terlengkap & Cepat</small>
            </div>
            <div class="text-end">
                <a href="<%= page_url('admin/dashboard') %>" class="text-secondary text-decoration-none small" style="opacity: 0.6;">
                    <i class="bi bi-shield-lock"></i> Panel Admin
                </a>
            </div>
        </div>
        <hr class="border-secondary opacity-25">
        <p class="mb-0 text-secondary small">
            © <%= new Date().getFullYear() %> Rosa Indah Printing. Hak Cipta Dilindungi.
        </p>
    </div>
</footer>

<!-- MOBILE APP BOTTOM NAVIGATION BAR (5 MENU DENGAN 1 DI TENGAH BULAT PRIMARY) -->
<nav class="mobile-bottom-nav d-md-none" aria-label="Navigasi Menu Mobile">
    <a href="<%= page_url('') %>" class="mobile-nav-item <%= (typeof current_path !== 'undefined' && (current_path === '/' || current_path === '')) ? 'active' : '' %>">
        <i class="bi bi-house-door-fill"></i>
        <span>Beranda</span>
    </a>
    <a href="<%= page_url('produk') %>" class="mobile-nav-item <%= (typeof current_path !== 'undefined' && (current_path.startsWith('/produk') || current_path.startsWith('/detail-produk'))) ? 'active' : '' %>">
        <i class="bi bi-grid-fill"></i>
        <span>Katalog</span>
    </a>

    <!-- Menu Tengah Bulat Berwarna Primary -->
    <a href="<%= page_url('cart') %>" class="mobile-nav-center <%= (typeof current_path !== 'undefined' && current_path.startsWith('/cart')) ? 'active' : '' %>" aria-label="Pesan & Keranjang">
        <div class="center-bubble">
            <i class="bi bi-bag-plus-fill"></i>
            <% if (cart_count > 0) { %>
                <span class="center-badge"><%= cart_count %></span>
            <% } %>
        </div>
        <span class="center-label">Pesan</span>
    </a>

    <a href="<%= page_url('promo') %>" class="mobile-nav-item <%= (typeof current_path !== 'undefined' && current_path.startsWith('/promo')) ? 'active' : '' %>">
        <i class="bi bi-ticket-perforated-fill"></i>
        <span>Promo</span>
    </a>
    <a href="<%= page_url('lacak-pesanan') %>" class="mobile-nav-item <%= (typeof current_path !== 'undefined' && current_path.startsWith('/lacak-pesanan')) ? 'active' : '' %>">
        <i class="bi bi-search"></i>
        <span>Lacak</span>
    </a>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
    if (typeof AOS !== 'undefined') {
        AOS.init({
            duration: 800,
            once: true
        });
    }
</script>
<script src="<%= asset_url('js/main.js') %>"></script>
</body>
</html>
