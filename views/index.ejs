<%- include('partials/header', { title: 'Solusi Percetakan Online Terlengkap' }) %>

<header class="main-header">
    <%- include('partials/topbar') %>
    <%- include('partials/navbar') %>
</header>

<!-- =========================
     HERO SECTION
========================== -->
<section class="hero" id="beranda">
    <div class="container hero-wrapper">
        <div class="hero-left" data-aos="fade-right">
            <!-- Live Badge dari acuan code -->
            <div class="hero-live-badge">
                <span class="ping-dot"></span>
                <span>Percetakan Online #1 Pilihan Brand &amp; UMKM</span>
            </div>

            <!-- Main Headline sesuai acuan code -->
            <h1>
                Cetak Ide Kreatifmu Lebih <br class="d-none d-sm-inline">
                <span class="text-gradient">Berwarna</span> &amp; Berkelas!
            </h1>

            <p class="hero-subtext">
                Dari stiker label kemasan, standing pouch, brosur promosi, hingga undangan eksklusif. <strong>Rosa Indah Printing</strong> menghadirkan kualitas cetak beresolusi tinggi dengan warna akurat, proses kilat, dan harga bersahabat.
            </p>

            <div class="hero-button">
                <a href="<%= page_url('produk') %>" class="btn-primary">
                    <i class="bi bi-sparkles me-1"></i> Pesan Sekarang
                </a>
                <a href="<%= page_url('produk') %>" class="btn-outline">
                    <i class="bi bi-grid me-1"></i> Lihat Produk
                </a>
            </div>

            <!-- Trust Highlights Strip dari acuan code -->
            <div class="hero-trust-strip">
                <div>
                    <div class="trust-number text-rosa">
                        <span class="counter" data-target="15400">0</span><span>+</span>
                    </div>
                    <p class="trust-label">Order Selesai</p>
                </div>
                <div>
                    <div class="trust-number text-rosa">
                        <span>24</span><span class="small-unit">Jam</span>
                    </div>
                    <p class="trust-label">Layanan Cetak Kilat</p>
                </div>
                <div>
                    <div class="trust-number text-rosa">
                        <span>4.9</span><i class="bi bi-star-fill text-warning fs-6 ms-1"></i>
                    </div>
                    <p class="trust-label">Rating Pelanggan</p>
                </div>
            </div>
        </div>

        <div class="hero-right" data-aos="fade-left">
            <div class="hero-mockup-frame">
                <img src="<%= asset_url('images/hero/mockup-printing.png') %>" alt="Rosa Indah Printing Hero Mockup">
                <!-- Floating Badge Keunggulan -->
                <div class="hero-floating-badge badge-top-left">
                    <div class="floating-badge-icon">
                        <i class="bi bi-palette-fill"></i>
                    </div>
                    <div>
                        <strong>Garansi Warna Akurat</strong>
                        <small>Kalibrasi Mesin Digital</small>
                    </div>
                </div>
                <div class="hero-floating-badge badge-bottom-right">
                    <div class="floating-badge-icon badge-green">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <strong>Gratis Cek File Desain</strong>
                        <small>Dibantu Tim Desainer</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================
     KATEGORI PRODUK
========================== -->
<section class="product-category" id="kategori">
    <div class="container">
        <div class="section-title">
            <div>
                <span>KATEGORI PRODUK</span>
                <h2>Pilihan Kategori Percetakan</h2>
                <p>Temukan produk cetak berkualitas sesuai kebutuhan bisnis, acara, dan promosi Anda.</p>
            </div>
            <a href="<%= page_url('produk') %>" class="lihat-semua">Lihat Semua →</a>
        </div>

        <div class="category-row">
            <% (homeCategories || []).forEach(function(cat) { %>
                <a
                    class="category-card"
                    href="<%= page_url('produk?kategori=' + encodeURIComponent(cat.category)) %>"
                    aria-label="Lihat produk kategori <%= cat.category %>">
                    <img src="<%= asset_url('images/products/' + cat.image) %>" alt="<%= cat.name %>" loading="lazy">
                    <h4><%= cat.name %></h4>
                    <p><%= cat.desc %></p>
                </a>
            <% }); %>
        </div>
    </div>
</section>

<!-- =========================
     KEUNGGULAN BAR (WHY CHOOSE US)
========================== -->
<section class="keunggulan-bar">
    <div class="container">
        <div class="keunggulan-grid">
            <div class="keunggulan-item">
                <div class="keunggulan-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <div>
                    <h4>Cetak Sameday</h4>
                    <p>Bisa ditunggu &amp; kirim instan</p>
                </div>
            </div>
            <div class="keunggulan-item">
                <div class="keunggulan-icon">
                    <i class="bi bi-award-fill"></i>
                </div>
                <div>
                    <h4>Kualitas Premium</h4>
                    <p>Tinta original tajam &amp; awet</p>
                </div>
            </div>
            <div class="keunggulan-item">
                <div class="keunggulan-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <h4>Harga Grosir UMKM</h4>
                    <p>Makin banyak makin hemat</p>
                </div>
            </div>
            <div class="keunggulan-item">
                <div class="keunggulan-icon">
                    <i class="bi bi-headset"></i>
                </div>
                <div>
                    <h4>Konsultasi Gratis</h4>
                    <p>Admin ramah siap bantu</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================
     PRODUK UNGGULAN
========================== -->
<section class="featured-products">
    <div class="container">
        <div class="section-title">
            <div>
                <span>PRODUK TERLARIS</span>
                <h2>Produk Unggulan</h2>
                <p>Kebutuhan percetakan populer dengan harga terbaik dan review pelanggan bintang 5.</p>
            </div>
            <a href="<%= page_url('produk') %>" class="lihat-semua">Lihat Semua →</a>
        </div>

        <div class="product-grid">
            <% featuredProducts.forEach(function(item) { %>
                <article class="catalog-card" data-aos="fade-up">
                    <a href="<%= page_url('detail-produk?id=' + encodeURIComponent(item.id)) %>" class="catalog-card-image">
                        <img src="<%= product_image_url(item.image) %>" alt="<%= item.name %>" loading="lazy">
                        <span class="catalog-badge"><%= item.category %></span>
                    </a>
                    <div class="catalog-card-body">
                        <div class="catalog-rating"><i class="bi bi-star-fill"></i> 5.0 <span>•</span> Produk custom</div>
                        <h3><%= item.name %></h3>
                        <p><%= item.description %></p>
                        <div class="catalog-card-bottom">
                            <div>
                                <small>Mulai dari</small>
                                <strong><%= format_rupiah(item.price) %> <em>/ <%= item.unit %></em></strong>
                            </div>
                            <a href="<%= page_url('detail-produk?id=' + encodeURIComponent(item.id)) %>" class="catalog-arrow" aria-label="Lihat detail <%= item.name %>">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </article>
            <% }); %>
        </div>
    </div>
</section>

<!-- =========================
     CARA PEMESANAN / TIMELINE
========================== -->
<section class="how-it-works" id="cara-pemesanan">
    <div class="container">
        <div class="section-title">
            <span>Proses Pemesanan</span>
            <h2>Cara Pemesanan Mudah</h2>
            <p>Hanya 4 langkah praktis untuk mencetak bersama <strong>Rosa Indah Printing</strong>.</p>
        </div>

        <div class="timeline">
            <div class="timeline-line"></div>

            <div class="step" data-aos="fade-up" data-aos-delay="100">
                <div class="step-icon"><i class="bi bi-whatsapp"></i></div>
                <div class="step-number">01</div>
                <h4>Pilih & Konsultasi</h4>
                <p>Pilih produk melalui website atau konsultasikan langsung via WhatsApp.</p>
            </div>

            <div class="step" data-aos="fade-up" data-aos-delay="200">
                <div class="step-icon"><i class="bi bi-palette"></i></div>
                <div class="step-number">02</div>
                <h4>Kirim / Buat Desain</h4>
                <p>Kirim file siap cetak atau tim kami siap bantu penataan desain yang rapi.</p>
            </div>

            <div class="step" data-aos="fade-up" data-aos-delay="300">
                <div class="step-icon"><i class="bi bi-printer"></i></div>
                <div class="step-number">03</div>
                <h4>Proses Cetak & Finishing</h4>
                <p>Pesanan langsung masuk ke antrian mesin percetakan presisi tinggi.</p>
            </div>

            <div class="step" data-aos="fade-up" data-aos-delay="400">
                <div class="step-icon"><i class="bi bi-box-seam"></i></div>
                <div class="step-number">04</div>
                <h4>Pengambilan / Kirim</h4>
                <p>Pesanan dipacking aman dan siap diambil di lokasi atau dikirim ke alamat Anda.</p>
            </div>
        </div>
    </div>
</section>

<!-- =========================
     HASIL CETAK TERBARU / PORTOFOLIO
========================== -->
<section class="portfolio">
    <div class="container">
        <div class="section-title">
            <span>Portofolio Kami</span>
            <h2>Hasil Cetak Terbaru</h2>
            <p>Sebagian hasil produksi terbaik Rosa Indah Printing yang telah dipercaya pelanggan.</p>
        </div>

        <div class="portfolio-grid">
            <% portfolios.slice(0, 8).forEach(function(item) { %>
                <a href="<%= page_url('detail-portofolio?id=' + item.id) %>" class="portfolio-card" data-aos="zoom-in" title="<%= item.product_name %>">
                    <img src="<%= product_image_url(item.image) %>" alt="<%= item.product_name %>" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-tag"><i class="bi bi-patch-check-fill me-1"></i> Order Selesai</span>
                        <h5><%= item.product_name %></h5>
                        <span class="portfolio-client"><i class="bi bi-person-fill me-1"></i><%= item.customer_name %></span>
                    </div>
                </a>
            <% }); %>
        </div>
        <div class="text-center mt-4">
            <a href="<%= page_url('portfolio') %>" class="catalog-primary-btn">Lihat Semua Portofolio</a>
        </div>
    </div>
</section>

